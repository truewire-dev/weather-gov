{
  "docs": "https://www.weather.gov/documentation/services-web-api#/default/zone_forecast",
  "meta": {
    "payload": "properties"
  },
  "envelope": {
    "payload": "properties"
  },
  "spec": {
    "kind": "rpc",
    "transports": [
      "http"
    ],
    "path": "/zones/{zone_type}/{zone_id}/forecast",
    "method": "GET",
    "description": "The text forecast for a public forecast zone: the forecaster's narrative, period by period, for the week ahead. Coarser than `forecast.get_forecast`, which renders one grid cell; this is what is read on NOAA Weather Radio for the whole zone.",
    "request": {
      "title": "GetZoneForecastRequest",
      "type": "object",
      "description": "Which zone.",
      "properties": {
        "zone_type": {
          "type": "string",
          "enum": [
            "land",
            "marine",
            "forecast",
            "public",
            "coastal",
            "offshore",
            "fire",
            "county"
          ],
          "description": "The zone type. Only public zones have one, addressed as `forecast`, `public` or `land`; a county, fire or marine zone answers 404."
        },
        "zone_id": {
          "type": "string",
          "description": "Public zone code, such as `WAZ315`."
        }
      },
      "required": [
        "zone_type",
        "zone_id"
      ]
    },
    "response": {
      "title": "ZoneForecastFeature",
      "type": "object",
      "description": "The forecast, in the GeoJSON feature the API wraps it in. The geometry is the outline of the zone the caller named, so the client hands back `properties`.",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Feature"
          ],
          "description": "Always `Feature`."
        },
        "geometry": {
          "$ref": "ZoneGeometry",
          "description": "Outline of the zone."
        },
        "properties": {
          "title": "ZoneForecast",
          "type": "object",
          "description": "The forecast itself.",
          "properties": {
            "zone": {
              "type": "string",
              "description": "URL of the zone the forecast is for."
            },
            "updated": {
              "type": "string",
              "format": "date-time",
              "description": "When the forecaster issued it."
            },
            "periods": {
              "type": "array",
              "description": "The forecast periods, in order.",
              "items": {
                "title": "ZoneForecastPeriod",
                "type": "object",
                "description": "One period: a named half-day.",
                "properties": {
                  "number": {
                    "type": "integer",
                    "description": "Sequence number within the forecast, starting at 1."
                  },
                  "name": {
                    "type": "string",
                    "description": "Name of the period, such as `Tonight` or `Wednesday Night`."
                  },
                  "detailedForecast": {
                    "type": "string",
                    "description": "The forecaster's text for the period."
                  }
                },
                "required": [
                  "number",
                  "name",
                  "detailedForecast"
                ]
              }
            }
          },
          "required": [
            "zone",
            "updated",
            "periods"
          ]
        }
      },
      "required": [
        "type",
        "properties"
      ]
    }
  }
}
