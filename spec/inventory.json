{
  "source": "https://www.weather.gov/documentation/services-web-api",
  "approved": null,
  "endpoints": [
    {"method": "GET", "path": "/alerts/active", "endpoint": "alerts.get_active_alerts"},
    {"method": "GET", "path": "/alerts/{id}", "endpoint": "alerts.get_alert"},
    {"method": "GET", "path": "/gridpoints/{wfo}/{x},{y}", "endpoint": "forecast.get_grid_data"},
    {"method": "GET", "path": "/gridpoints/{wfo}/{x},{y}/forecast", "endpoint": "forecast.get_forecast"},
    {"method": "GET", "path": "/gridpoints/{wfo}/{x},{y}/forecast/hourly", "endpoint": "forecast.get_hourly_forecast"},
    {"method": "GET", "path": "/icons/{set}/{timeOfDay}/{first}", "excluded": "deprecated in the OpenAPI; image/png response"},
    {"method": "GET", "path": "/icons/{set}/{timeOfDay}/{first}/{second}", "excluded": "deprecated in the OpenAPI; image/png response"},
    {"method": "GET", "path": "/icons", "excluded": "deprecated in the OpenAPI (icon services are deprecated)"},
    {"method": "GET", "path": "/thumbnails/satellite/{area}", "excluded": "deprecated in the OpenAPI; image/jpeg response"},
    {"method": "GET", "path": "/stations/{stationId}/observations", "endpoint": "stations.get_observations"},
    {"method": "GET", "path": "/stations/{stationId}/observations/latest", "endpoint": "stations.get_latest_observation"},
    {"method": "GET", "path": "/stations/{stationId}/tafs/{date}/{time}", "excluded": "XML-only response (application/vnd.wmo.iwxxm+xml); no JSON representation"},
    {"method": "GET", "path": "/stations", "endpoint": "stations.list_stations"},
    {"method": "GET", "path": "/offices/{officeId}", "endpoint": "offices.get_office"},
    {"method": "GET", "path": "/offices/{officeId}/briefing/download/latest", "excluded": "responds 302 with no body, redirecting to the briefing PDF download"},
    {"method": "GET", "path": "/offices/{officeId}/briefing/download/{briefingId}", "excluded": "binary response (application/pdf only)"},
    {"method": "GET", "path": "/offices/{officeId}/weatherstories/download/{imageId}", "excluded": "binary response (image/* only)"},
    {"method": "GET", "path": "/points/{latitude},{longitude}", "endpoint": "points.get_point"},
    {"method": "GET", "path": "/points/{latitude},{longitude}/radio", "excluded": "XML-only response (application/ssml+xml); no JSON representation"},
    {"method": "GET", "path": "/points/{latitude},{longitude}/stations", "excluded": "deprecated in the OpenAPI"},
    {"method": "GET", "path": "/radio/{callSign}/broadcast", "excluded": "XML-only response (application/ssml+xml); no JSON representation"},
    {"method": "GET", "path": "/products/types", "endpoint": "products.list_product_types"},
    {"method": "GET", "path": "/zones", "endpoint": "zones.list_zones"},
    {"method": "GET", "path": "/zones/{type}", "endpoint": "zones.list_zones_by_type"},
    {"method": "GET", "path": "/zones/{type}/{zoneId}", "endpoint": "zones.get_zone"},
    {"method": "GET", "path": "/zones/{type}/{zoneId}/forecast", "endpoint": "zones.get_forecast"},
    {"method": "GET", "path": "/zones/{type}/{zoneId}/radio", "endpoint": "zones.list_transmitters"},
    {"method": "GET", "path": "/zones/forecast/{zoneId}/observations", "endpoint": "stations.get_observations_for_zone"},
    {"method": "GET", "path": "/zones/forecast/{zoneId}/stations", "endpoint": "stations.list_stations_for_zone"},
    {"method": "GET", "path": "/gridpoints/{wfo}/{x},{y}/stations", "endpoint": "stations.list_stations_for_gridpoint"},
    {"method": "GET", "path": "/radar/servers", "endpoint": "radar.list_servers"},
    {"method": "GET", "path": "/radar/servers/{id}", "endpoint": "radar.get_server"},
    {"method": "GET", "path": "/radar/spgds", "endpoint": "radar.list_spgds"},
    {"method": "GET", "path": "/radar/stations", "endpoint": "radar.list_stations"},
    {"method": "GET", "path": "/radar/stations/{stationId}", "endpoint": "radar.get_station"},
    {"method": "GET", "path": "/radar/stations/{stationId}/alarms", "endpoint": "radar.list_station_alarms"},
    {"method": "GET", "path": "/radar/queues/{host}", "endpoint": "radar.get_queue"},
    {"method": "GET", "path": "/radar/profilers/{stationId}", "endpoint": "radar.get_profiler"}
  ]
}
